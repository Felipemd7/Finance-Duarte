# 3. URL da Aplicação
APP_URL="http://localhost:3000"
PORT=3000

# 4. Bot do WhatsApp (processo separado — ver server/whatsapp/bot.ts)
# Roda em um host sempre ativo próprio (fora da Vercel), usando
# GEMINI_API_KEY e SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY acima.
# Deixe vazio na primeira execução: o bot vai logar o chatId de toda
# mensagem recebida no console — copie o do grupo autorizado para aqui
# e reinicie. Enquanto estiver vazio, NENHUMA mensagem é processada.
WHATSAPP_GROUP_ID=""
# Quem é o dono do número conectado ao bot: tudo que ESSE número manda no grupo é atribuído a ele.
WHATSAPP_OWNER_NAME="Felipe"
# Demais pessoas do grupo: "id:Nome" separados por vírgula. O id é o LID que aparece no log
# ("Autor desconhecido <id> — adicione em WHATSAPP_SENDER_MAP") ou o telefone, só dígitos.
WHATSAPP_SENDER_MAP="ID_DA_CAMILA:Camila"
# Porta do painel web local para escanear o QR Code (abra http://localhost:PORTA).
WHATSAPP_QR_PORT=3101

# Gemini (opcional): cadeia de modelos, do mais rápido ao mais pesado. Cada modelo tem cota própria.
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3.6-flash"
