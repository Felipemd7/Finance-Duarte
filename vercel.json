{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/scan-receipt",
      "destination": "/api/scan-receipt"
    },
    {
      "source": "/api/scan-fuel-receipt",
      "destination": "/api/scan-fuel-receipt"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
